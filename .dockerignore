# Files listed here are left out of the image. The image only needs main.py,
# jfapi.py and the jellychord/ package. requirements.txt must stay in the build
# context, because the Dockerfile mounts it to install dependencies.

# Local configuration, which may hold the Discord token and Jellyfin API key
config.yml
**/.env

# Git, CI and editor files
**/.git
**/.gitignore
**/.gitattributes
**/.github
**/.vscode
**/.DS_Store

# Python caches and environments
**/__pycache__
**/.pytest_cache
**/.venv
**/.poetry

# Docker files
**/.dockerignore
**/Dockerfile*
**/compose.y*ml
**/docker-compose*

# Tests, documentation and project metadata
**/tests
config.yml.example
LICENSE
README.md
README.Docker.md
poetry.lock
pyproject.toml
renovate.json
